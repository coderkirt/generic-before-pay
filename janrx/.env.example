# Copy to .env and fill in. NEVER commit .env. No secrets belong in this file.
APP_ENV=dev                      # dev | prod
LOG_LEVEL=INFO

# CORS: comma-separated exact origins of the PWA frontend. No "*" in prod.
CORS_ORIGINS=http://localhost:3000

# OCR provider: gemma (Ollama) | gemini (Google cloud) | rapidocr (local CPU) | handwriting (OpenCV+EMNIST) | mock
OCR_PROVIDER=mock

# Gemma runtime: any OpenAI-compatible /v1/chat/completions endpoint that accepts image input.
# Default: Ollama serving Gemma 4 E4B (vision). Confirm `ollama list` if you use another tag.
GEMMA_BASE_URL=http://host.docker.internal:11434/v1
GEMMA_MODEL=gemma4:e4b
GEMMA_API_KEY=

# Gemini (hosted). Get a key at https://aistudio.google.com/apikey  — photos leave this machine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Upload limits and timeouts
OCR_MAX_BYTES=5242880            # 5 MB
OCR_MAX_PIXELS=25000000
OCR_TIMEOUT_SECONDS=20

# Rate limit for /v1/ocr (per client, per minute). In-memory, per process.
# If you run more than one API replica, put a shared Redis limiter in front or keep a single replica.
OCR_RATE_LIMIT_PER_MINUTE=10
# Only true if a trusted reverse proxy sets X-Forwarded-For. Never enable on a public port.
TRUST_PROXY=false

# Folder with brands.json, janaushadhi_products.json, kendras.json
DATA_DIR=data
